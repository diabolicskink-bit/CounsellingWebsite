{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/enquiry.ts": {
      "includeFiles": "src/{data/enquiryContract.ts,server/enquiry/**,utils/timeZones.ts}"
    }
  },
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/about",
      "destination": "/working-with-joel",
      "permanent": true
    },
    {
      "source": "/fees",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/inclusion",
      "destination": "/inclusive-counselling",
      "permanent": true
    }
  ]
}
