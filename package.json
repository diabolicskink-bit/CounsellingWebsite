{
  "name": "vive-counselling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "db:migrate:production": "node --env-file=.env.production.local scripts/apply-database-migrations.mjs",
    "db:migrate:preview": "node --env-file=.env.preview.local scripts/apply-database-migrations.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "build": "node scripts/validate-analytics-env.mjs && tsc -b && npm run build:client && npm run build:server && node scripts/prerender-route-metadata.mjs",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx",
    "preview": "vite preview --host 127.0.0.1",
    "preview:qa": "vite preview --host 127.0.0.1 --port 4287 --strictPort",
    "test:api": "node --test tests/api/*.test.mjs",
    "test:scripts": "node --test tests/scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "qa": "npm run check:encoding && npm run typecheck:tests && npm run test:scripts && npm run build && npm run test:api && start-server-and-test preview:qa http://127.0.0.1:4287 test:e2e",
    "qa:site": "npm run check:encoding && npm run typecheck:tests && npm run build && start-server-and-test preview:qa http://127.0.0.1:4287 test:e2e",
    "qa:analytics": "npm run typecheck:tests && node scripts/run-analytics-qa.mjs",
    "audit:lighthouse": "npm run build && start-server-and-test preview:qa http://127.0.0.1:4287 audit:lighthouse:run",
    "audit:lighthouse:run": "node scripts/run-lighthouse.mjs http://127.0.0.1:4287"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/functions": "^3.9.3",
    "botid": "^1.5.11",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "lighthouse": "^13.4.1",
    "playwright": "^1.59.1",
    "start-server-and-test": "^3.0.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.1"
  }
}
