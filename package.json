{
  "name": "vive-counselling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "db:migrate:production": "node --env-file=.env.production.local database/migrate.mjs",
    "db:migrate:preview": "node --env-file=.env.preview.local database/migrate.mjs",
    "check:encoding": "node scripts/qa/check-encoding.mjs",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "build": "node scripts/build/validate-analytics-env.mjs && tsc -b && npm run build:client && npm run build:server && node scripts/build/prerender-route-metadata.mjs",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx",
    "preview": "vite preview --host 127.0.0.1",
    "preview:qa": "vite preview --host 127.0.0.1 --port 4287 --strictPort",
    "test:node": "node --test tests/node/**/*.test.mjs",
    "test:api": "node --test tests/node/analytics/*.test.mjs tests/node/enquiry/*.test.mjs tests/node/visits/*.test.mjs tests/node/server/*.test.mjs",
    "test:analytics": "npm run test:api && node --test tests/node/tooling/database-migrations.test.mjs tests/node/tooling/saved-visit-queries.test.mjs",
    "test:database": "node --test tests/database/*.test.mjs",
    "test:e2e": "playwright test tests/browser/public-site",
    "test:e2e:headed": "playwright test tests/browser/public-site --headed",
    "qa": "npm run check:encoding && npm run typecheck:tests && npm run test:node && npm run build && start-server-and-test preview:qa http://127.0.0.1:4287 test:e2e",
    "qa:site": "npm run check:encoding && npm run typecheck:tests && npm run build && start-server-and-test preview:qa http://127.0.0.1:4287 test:e2e",
    "qa:analytics": "npm run typecheck:tests && node scripts/qa/run-analytics-qa.mjs",
    "audit:lighthouse": "npm run build && start-server-and-test preview:qa http://127.0.0.1:4287 audit:lighthouse:run",
    "audit:lighthouse:run": "node scripts/qa/run-lighthouse.mjs http://127.0.0.1:4287"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/functions": "^3.9.3",
    "botid": "^1.5.11",
    "lucide-react": "^0.468.0",
    "node-device-detector": "2.2.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "lighthouse": "^13.1.0",
    "playwright": "^1.59.1",
    "start-server-and-test": "^3.0.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.8"
  }
}
